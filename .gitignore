# ==============================================================================
# MeghVault Cloud Storage - Monorepo .gitignore
# Covers Root, Client (Vite/React), and Server (Node.js/Express/MongoDB)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secrets (Never commit credentials!)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
client/.env
client/.env.*
server/.env
server/.env.*

# Explicitly preserve example environment templates
!.env.example
!client/.env.example
!server/.env.example

# ------------------------------------------------------------------------------
# 3. User Uploads & Physical File Storage
# Crucial for MeghVault: Ignores physical user files, temp archives, and chunks
# ------------------------------------------------------------------------------
storage/*
server/storage/*
!server/storage/.gitkeep
uploads/
server/uploads/
temp/
tmp/
*.tmp

# ------------------------------------------------------------------------------
# 4. Production & Build Outputs
# ------------------------------------------------------------------------------
dist/
dist-ssr/
client/dist/
client/dist-ssr/
build/
out/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. Logs & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# 7. IDE & Editor Artifacts
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 8. Testing & Code Quality Caches
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
.eslintcache
.stylelintcache
.cache/
