# ==============================================================================
# MeghVault Cloud Storage - Server Environment Variables Configuration
# Copy this file to '.env' and fill in the values appropriate for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database (MongoDB)
# NOTE: MeghVault uses atomic transactions for folder deletion, email migration,
# and ownership transfers. Transactions require a replica set or MongoDB Atlas.
# Local replica set example: mongodb://localhost:27017/meghvault?replicaSet=rs0
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/meghvault
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/meghvault?replicaSet=rs0

# ------------------------------------------------------------------------------
# 3. Security, Cookies & Session Management
# ------------------------------------------------------------------------------
# Secret key used for signing cookies and cryptographic HMAC token generation
# Generate a strong random key (e.g. `openssl rand -base64 32`)
MY_SECERT_KEY=your_super_secret_cookie_signing_key_min_32_characters

# Enforces the Secure flag on all cookies (HttpOnly, SameSite=Lax).
# Set to 'false' for local HTTP development; set to 'true' in staging/production (HTTPS).
COOKIE_SECURE=false

# Optional: Set to 'true' to combine session ID and IP address in rate limiting keys (sess_<sid>#ip_<ip>)
RATE_LIMIT_COMPOSITE_KEY=false

# ------------------------------------------------------------------------------
# 4. Email Service (Resend)
# Used for passwordless Email OTP verification, dual-OTP email migration,
# and account ownership transfer authorization notices.
# Obtain your key from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 5. Token Encryption (AES-256-GCM)
# Used to encrypt sensitive third-party OAuth refresh tokens at rest in MongoDB.
# Must be a 64-character hexadecimal string (32 bytes) or a strong secret phrase.
# Generate one using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_SECRET=your_64_character_hex_encryption_secret_here

# ------------------------------------------------------------------------------
# 6. Google OAuth 2.0 & Cloud Integrations
# Setup via Google Cloud Console: https://console.cloud.google.com/
# Required APIs: Google Drive API, Google Photos Picker API, Google Identity / People API
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Single Sign-On Callback URI (Registered in Google Cloud Console > Authorized redirect URIs)
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Google Drive Cloud Import Callback URI
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/auth/google-drive/callback

# Google Photos Cloud Import Callback URI
GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:4000/auth/google-photos/callback

# ------------------------------------------------------------------------------
# 7. GitHub OAuth 2.0 Integration & SSO
# Setup via GitHub Developer Settings > OAuth Apps: https://github.com/settings/developers
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub OAuth Callback URI (Registered in GitHub OAuth App > Authorization callback URL)
GITHUB_REDIRECT_URI=http://localhost:4000/auth/github/callback
