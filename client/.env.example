# ==============================================================================
# MeghVault Cloud Storage - Client Environment Variables Configuration
# Copy this file to '.env' (or '.env.local') in the client root directory.
# Note: In Vite, all client-exposed variables must begin with the 'VITE_' prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Base URL
# URL where the Express backend server is running.
# In local development with Vite proxy, you can leave this as http://localhost:4000
# In production, set to your deployed backend origin (e.g. https://api.meghvault.com)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 Client Authentication (SSO)
# Web Client ID from Google Cloud Console (Credentials > OAuth 2.0 Client IDs).
# Must match the GOOGLE_CLIENT_ID configured on the server.
# ------------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. Google Drive Integration (Native Google Picker API)
# Required for the official Google Drive Picker dialog in the web dashboard.
#
# VITE_GOOGLE_API_KEY: Browser API Key with Google Picker API enabled
# (Google Cloud Console > APIs & Services > Credentials > Create Credentials > API Key)
#
# VITE_GOOGLE_APP_ID: Google Cloud Project Number (numeric project ID found
# in Google Cloud Console Project Dashboard / Project info).
# ------------------------------------------------------------------------------
VITE_GOOGLE_API_KEY=your_google_cloud_api_key_here
VITE_GOOGLE_APP_ID=your_google_cloud_project_number_here

# ------------------------------------------------------------------------------
# 4. GitHub OAuth 2.0 Integration & SSO
# GitHub OAuth App Client ID (Settings > Developer settings > OAuth Apps).
# Must match the GITHUB_CLIENT_ID configured on the server.
# ------------------------------------------------------------------------------
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
